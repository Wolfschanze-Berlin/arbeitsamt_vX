{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arbeitsamtvx",
  "version": "0.1.0",
  "identifier": "com.franc.arbeitsamtvx",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "arbeitsamtvx",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "description": "arbeitsamtvx CLI",
      "args": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["arbeitsamt"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}